# systemd unit for opencap. Install and usage: docs/deployment.md.
#
#   /opt/opencap/venv          virtualenv with opencap installed
#   /etc/opencap/              poller.yaml, devices.json, devices_map.yaml, overrides.yaml
#   /etc/opencap/opencap.env   secrets (OPENCAP_MQTT_PASSWORD, OPENCAP_API_TOKEN, ...), mode 0640
#   /var/lib/opencap/          working directory: data/saf.sqlite (store-and-forward outbox)
#
# Logs are JSON lines on stdout -> journald:  journalctl -u opencap -f -o cat
# Reload the config without a restart:        systemctl reload opencap   (SIGHUP)

[Unit]
Description=opencap read-only PLC connectivity server (polls PLCs, publishes to MQTT)
Documentation=https://github.com/sharmaniraj009/opencap
Wants=network-online.target
After=network-online.target
# Keep restarting for as long as it fails: a PLC gateway should never give up.
StartLimitIntervalSec=0

[Service]
Type=simple
User=opencap
Group=opencap
EnvironmentFile=-/etc/opencap/opencap.env
WorkingDirectory=/var/lib/opencap
ExecStart=/opt/opencap/venv/bin/opencap run --config /etc/opencap
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencap

# /var/lib/opencap, created and owned by User= on start.
StateDirectory=opencap
StateDirectoryMode=0750

# Hardening: opencap needs outbound TCP to PLCs/broker and one listening port for the API.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027
# Serial drivers (Modbus RTU, DF1) need the device: drop PrivateDevices=yes and add e.g.
#   DeviceAllow=/dev/ttyUSB0 rw
#   SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
