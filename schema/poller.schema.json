{
  "$defs": {
    "ApiCfg": {
      "additionalProperties": false,
      "properties": {
        "bind": {
          "default": "127.0.0.1",
          "title": "Bind",
          "type": "string"
        },
        "port": {
          "default": 8080,
          "title": "Port",
          "type": "integer"
        },
        "token_env": {
          "default": "OPENCAP_API_TOKEN",
          "title": "Token Env",
          "type": "string"
        }
      },
      "title": "ApiCfg",
      "type": "object"
    },
    "CheckCfg": {
      "additionalProperties": false,
      "properties": {
        "est_rtt_ms": {
          "default": 60.0,
          "title": "Est Rtt Ms",
          "type": "number"
        }
      },
      "title": "CheckCfg",
      "type": "object"
    },
    "DeviceDefaults": {
      "additionalProperties": false,
      "properties": {
        "demote_after": {
          "default": 3,
          "title": "Demote After",
          "type": "integer"
        },
        "demote_for_ms": {
          "default": 30000,
          "title": "Demote For Ms",
          "type": "integer"
        },
        "min_scan_ms": {
          "default": 1000,
          "title": "Min Scan Ms",
          "type": "integer"
        },
        "retries": {
          "default": 2,
          "title": "Retries",
          "type": "integer"
        },
        "scan_ms": {
          "default": 1000,
          "title": "Scan Ms",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 3000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "DeviceDefaults",
      "type": "object"
    },
    "MqttCfg": {
      "additionalProperties": false,
      "properties": {
        "ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "keepalive_s": {
          "default": 30,
          "title": "Keepalive S",
          "type": "integer"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "OPENCAP_MQTT_PASSWORD",
          "title": "Password Env"
        },
        "port": {
          "default": 1883,
          "title": "Port",
          "type": "integer"
        },
        "qos": {
          "default": 1,
          "title": "Qos",
          "type": "integer"
        },
        "tls": {
          "default": false,
          "title": "Tls",
          "type": "boolean"
        },
        "topic_prefix": {
          "default": "opencap",
          "title": "Topic Prefix",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "title": "MqttCfg",
      "type": "object"
    },
    "PayloadCfg": {
      "additionalProperties": false,
      "properties": {
        "bad_tags_field": {
          "default": true,
          "title": "Bad Tags Field",
          "type": "boolean"
        },
        "float_decimals": {
          "default": 4,
          "title": "Float Decimals",
          "type": "integer"
        },
        "timezone": {
          "default": "Asia/Kolkata",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "PayloadCfg",
      "type": "object"
    },
    "SafCfg": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 2147483648,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "default": "data/saf.sqlite",
          "title": "Path",
          "type": "string"
        }
      },
      "title": "SafCfg",
      "type": "object"
    }
  },
  "$id": "https://github.com/sharmaniraj009/opencap/schema/poller.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api": {
      "$ref": "#/$defs/ApiCfg"
    },
    "check": {
      "$ref": "#/$defs/CheckCfg"
    },
    "defaults": {
      "$ref": "#/$defs/DeviceDefaults"
    },
    "instance": {
      "default": "opencap-1",
      "title": "Instance",
      "type": "string"
    },
    "log_level": {
      "default": "INFO",
      "title": "Log Level",
      "type": "string"
    },
    "mqtt": {
      "$ref": "#/$defs/MqttCfg"
    },
    "payload": {
      "$ref": "#/$defs/PayloadCfg"
    },
    "saf": {
      "$ref": "#/$defs/SafCfg"
    },
    "stats_interval_s": {
      "default": 300.0,
      "title": "Stats Interval S",
      "type": "number"
    }
  },
  "title": "PollerConfig",
  "type": "object",
  "version": 1
}
