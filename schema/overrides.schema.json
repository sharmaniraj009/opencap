        "negate": {
          "default": false,
          "title": "Negate",
          "type": "boolean"
        },
        "raw_hi": {
          "default": 1000.0,
          "title": "Raw Hi",
          "type": "number"
        },
        "raw_lo": {
          "default": 0.0,
          "title": "Raw Lo",
          "type": "number"
        },
        "type": {
