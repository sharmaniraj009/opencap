    "Scale": {
      "additionalProperties": false,
      "description": "Kepware-style tag scaling. Defaults match Kepware's defaults.",
      "properties": {
        "clamp_hi": {
          "default": false,
          "title": "Clamp Hi",
          "type": "boolean"
