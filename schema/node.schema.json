{
  "$defs": {
    "ApiCfg": {
      "additionalProperties": false,
      "properties": {
        "audit_log": {
          "default": "data/audit.jsonl",
          "title": "Audit Log",
          "type": "string"
        },
        "bind": {
          "default": "127.0.0.1",
          "title": "Bind",
          "type": "string"
        },
        "cors_origins": {
          "items": {
            "type": "string"
          },
          "title": "Cors Origins",
          "type": "array"
        },
        "port": {
          "default": 8080,
          "title": "Port",
          "type": "integer"
        },
        "token_env": {
          "default": "OPENCAP_API_TOKEN",
          "title": "Token Env",
          "type": "string"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/ApiToken"
          },
          "title": "Tokens",
          "type": "array"
        }
      },
      "title": "ApiCfg",
      "type": "object"
    },
    "ApiToken": {
      "additionalProperties": false,
      "description": "A named API token (also used to log in to the web UI). The secret lives in the env var\n`token_env`, never in yaml.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "viewer",
          "enum": [
            "viewer",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        },
        "token_env": {
          "minLength": 1,
          "title": "Token Env",
          "type": "string"
        }
      },
      "required": [
        "name",
        "token_env"
      ],
      "title": "ApiToken",
      "type": "object"
    },
    "CheckCfg": {
      "additionalProperties": false,
      "properties": {
        "est_rtt_ms": {
          "default": 60.0,
          "title": "Est Rtt Ms",
          "type": "number"
        }
      },
      "title": "CheckCfg",
      "type": "object"
    },
    "DeviceDefaults": {
      "additionalProperties": false,
      "properties": {
        "demote_after": {
          "default": 3,
          "title": "Demote After",
          "type": "integer"
        },
        "demote_for_ms": {
          "default": 30000,
          "title": "Demote For Ms",
          "type": "integer"
        },
        "min_scan_ms": {
          "default": 1000,
          "title": "Min Scan Ms",
          "type": "integer"
        },
        "retries": {
          "default": 2,
          "title": "Retries",
          "type": "integer"
        },
        "scan_ms": {
          "default": 1000,
          "title": "Scan Ms",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 3000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "DeviceDefaults",
      "type": "object"
    },
    "MqttCfg": {
      "additionalProperties": false,
      "properties": {
        "ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "keepalive_s": {
          "default": 30,
          "title": "Keepalive S",
          "type": "integer"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "OPENCAP_MQTT_PASSWORD",
          "title": "Password Env"
        },
        "port": {
          "default": 1883,
          "title": "Port",
          "type": "integer"
        },
        "qos": {
          "default": 1,
          "title": "Qos",
          "type": "integer"
        },
        "tls": {
          "default": false,
          "title": "Tls",
          "type": "boolean"
        },
        "topic_prefix": {
          "default": "opencap",
          "title": "Topic Prefix",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "title": "MqttCfg",
      "type": "object"
    },
    "OpcUaServerCfg": {
      "additionalProperties": false,
      "description": "Northbound OPC UA server (PLAN Phase 6, docs/decisions.md D-046, D-088): the cache as a\nread-only, KEPServer-style address space. Off by default.",
      "properties": {
        "advertised_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advertised Endpoint"
        },
        "allow_insecure_remote": {
          "default": false,
          "title": "Allow Insecure Remote",
          "type": "boolean"
        },
        "anonymous": {
          "default": false,
          "title": "Anonymous",
          "type": "boolean"
        },
        "application_uri": {
          "default": "urn:opencap:server",
          "title": "Application Uri",
          "type": "string"
        },
        "certificate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "opc.tcp://127.0.0.1:4840/opencap",
          "title": "Endpoint",
          "type": "string"
        },
        "kepserverex_namespace_index": {
          "default": true,
          "title": "Kepserverex Namespace Index",
          "type": "boolean"
        },
        "max_monitored_items": {
          "default": 100000,
          "title": "Max Monitored Items",
          "type": "integer"
        },
        "max_references_per_browse": {
          "default": 1000,
          "title": "Max References Per Browse",
          "type": "integer"
        },
        "max_sessions": {
          "default": 100,
          "title": "Max Sessions",
          "type": "integer"
        },
        "max_subscriptions_per_session": {
          "default": 50,
          "title": "Max Subscriptions Per Session",
          "type": "integer"
        },
        "min_publishing_interval_ms": {
          "default": 100,
          "title": "Min Publishing Interval Ms",
          "type": "integer"
        },
        "min_sampling_interval_ms": {
          "default": 100,
          "title": "Min Sampling Interval Ms",
          "type": "integer"
        },
        "namespace_uri": {
          "default": "urn:opencap",
          "title": "Namespace Uri",
          "type": "string"
        },
        "password_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Env"
        },
        "pki_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pki Dir"
        },
        "private_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Key"
        },
        "security_policies": {
          "items": {
            "enum": [
              "None",
              "Basic256Sha256_Sign",
              "Basic256Sha256_SignAndEncrypt",
              "Aes128_Sha256_RsaOaep_Sign",
              "Aes128_Sha256_RsaOaep_SignAndEncrypt",
              "Aes256_Sha256_RsaPss_Sign",
              "Aes256_Sha256_RsaPss_SignAndEncrypt"
            ],
            "type": "string"
          },
          "title": "Security Policies",
          "type": "array"
        },
        "server_name": {
          "default": "opencap",
          "title": "Server Name",
          "type": "string"
        },
        "trusted_certs_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trusted Certs Dir"
        },
        "update_ms": {
          "default": 250,
          "title": "Update Ms",
          "type": "integer"
        },
        "username_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username Env"
        },
        "users": {
          "items": {
            "$ref": "#/$defs/OpcUaUserCfg"
          },
          "title": "Users",
          "type": "array"
        },
        "x509_users": {
          "default": false,
          "title": "X509 Users",
          "type": "boolean"
        }
      },
      "title": "OpcUaServerCfg",
      "type": "object"
    },
    "OpcUaUserCfg": {
      "additionalProperties": false,
      "description": "One OPC UA user name/password, both read from the environment variables named here.",
      "properties": {
        "password_env": {
          "title": "Password Env",
          "type": "string"
        },
        "username_env": {
          "title": "Username Env",
          "type": "string"
        }
      },
      "required": [
        "username_env",
        "password_env"
      ],
      "title": "OpcUaUserCfg",
      "type": "object"
    },
    "PayloadCfg": {
      "additionalProperties": false,
      "properties": {
        "bad_tags_field": {
          "default": true,
          "title": "Bad Tags Field",
          "type": "boolean"
        },
        "float_decimals": {
          "default": 4,
          "title": "Float Decimals",
          "type": "integer"
        },
        "timezone": {
          "default": "Asia/Kolkata",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "PayloadCfg",
      "type": "object"
    },
    "PluginsCfg": {
      "additionalProperties": false,
      "properties": {
        "python": {
          "$ref": "#/$defs/PythonPluginCfg"
        }
      },
      "title": "PluginsCfg",
      "type": "object"
    },
    "PythonPluginCfg": {
      "additionalProperties": false,
      "description": "The Python driver host the Rust engine starts for `plugin: python` devices (#49, proto/README.md).\nThe Python engine ignores it.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "start_timeout_ms": {
          "default": 30000,
          "title": "Start Timeout Ms",
          "type": "integer"
        },
        "transport": {
          "default": "auto",
          "enum": [
            "auto",
            "unix",
            "tcp"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "title": "PythonPluginCfg",
      "type": "object"
    },
    "SafCfg": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 2147483648,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "default": "data/saf.sqlite",
          "title": "Path",
          "type": "string"
        }
      },
      "title": "SafCfg",
      "type": "object"
    }
  },
  "$id": "https://github.com/sharmaniraj009/opencap/schema/node.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema of config/node.yaml (project v2): what differs per node. Today exactly the fields\nof `poller.yaml`, which it replaces; north agents move into the project when ADR-0005's\nnorth plug-in model lands, and the redundancy role (ADR-0012) is added here.",
  "properties": {
    "api": {
      "$ref": "#/$defs/ApiCfg"
    },
    "check": {
      "$ref": "#/$defs/CheckCfg"
    },
    "defaults": {
      "$ref": "#/$defs/DeviceDefaults"
    },
    "instance": {
      "default": "opencap-1",
      "title": "Instance",
      "type": "string"
    },
    "log_level": {
      "default": "INFO",
      "title": "Log Level",
      "type": "string"
    },
    "mqtt": {
      "$ref": "#/$defs/MqttCfg"
    },
    "opcua_server": {
      "$ref": "#/$defs/OpcUaServerCfg"
    },
    "payload": {
      "$ref": "#/$defs/PayloadCfg"
    },
    "plugins": {
      "$ref": "#/$defs/PluginsCfg"
    },
    "saf": {
      "$ref": "#/$defs/SafCfg"
    },
    "stats_interval_s": {
      "default": 300.0,
      "title": "Stats Interval S",
      "type": "number"
    }
  },
  "title": "NodeConfig",
  "type": "object",
  "version": 1
}
