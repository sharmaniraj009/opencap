# opencap secrets, one KEY=value per line. Copy to /etc/opencap/opencap.env (systemd),
# pass with `docker run --env-file`, or set as service environment on Windows.
# Keep this file out of version control and readable only by root and the opencap user:
#   install -m 0640 -o root -g opencap opencap.env.example /etc/opencap/opencap.env
#
# poller.yaml stores only the NAMES of these variables (mqtt.password_env, api.token_env,
# params.username_env / password_env), never the values.

# MQTT broker password (poller.yaml mqtt.username + mqtt.password_env).
OPENCAP_MQTT_PASSWORD=

# Bearer token for the admin API. Required when api.bind is not a loopback address.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENCAP_API_TOKEN=

# OPC UA client credentials, one pair per channel, as written by `opencap import-kep`:
# OPENCAP_OPCUA_<CHANNEL>_USER=
# OPENCAP_OPCUA_<CHANNEL>_PASSWORD=
