{
  "spec": "docs/spec/system-tags.md",
  "spec_version": 1,
  "comment": "Every system tag of the spec as data. 'present' names the condition of the spec's 'Present' column; 'kep' is true when the name and meaning are KEPServerEX's.",
  "levels": {
    "node": "_System.{tag}",
    "redundancy": "_System._Redundancy.{tag}",
    "north": "_System._North.{agent}.{tag}",
    "channel": "{channel}._System.{tag}",
    "channel_statistics": "{channel}._Statistics.{tag}",
    "device": "{channel}.{device}._System.{tag}",
    "device_statistics": "{channel}.{device}._Statistics.{tag}"
  },
  "presence": {
    "always": "always present",
    "client_agent": "north agents that connect to a peer (mqtt, sparkplug, rest_client)",
    "server": "north data servers (opcua_server, modbus_server)",
    "durable_agent": "north agents with an outbox",
    "serial_line": "every device of the channel is on a serial driver with transport serial",
    "serial_over_tcp": "channel: every device is on a serial driver with transport tcp; device: the device is",
    "bytes_counted": "device: its driver counts bytes; channel: every device's driver does"
  },
  "dtypes": [
    "bool",
    "uint32",
    "uint64",
    "float64",
    "string",
    "datetime",
    "string_array"
  ],
