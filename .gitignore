.venv/
__pycache__/
*.egg-info/
.pytest_cache/
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/

# Real site data: KEPServer exports, generated site config, reports. NEVER commit.
.private/
config/devices.json
config/devices_map.yaml
tests/fixtures/project.json
tests/fixtures/kep2poller_output.json

# Generated by `opencap import-kep`
reports/*
!reports/.gitkeep

# Written by the config API next to the config files (previous versions, temp files)
config/*.bak
config/.*.tmp
