{
 "format": 1,
 "area": "timezones/device_time",
 "description": "Device local time -> UTC around DST changes and for fixed offsets (DEV-13, #112). Gap: read with the offset before the jump; overlap: first occurrence.",
 "vectors": [
  {
   "id": "utc-identity",
   "description": "UTC: the local time is the UTC time",
   "input": {
    "zone": "UTC",
    "local": "2026-11-18T10:15:42.250"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-18T10:15:42.250Z",
    "fold": "none"
   }
  },
  {
   "id": "kolkata",
   "description": "Asia/Kolkata is UTC+05:30 all year",
   "input": {
    "zone": "Asia/Kolkata",
    "local": "2026-11-18T15:45:42.250"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-18T10:15:42.250Z",
    "fold": "none"
   }
  },
  {
   "id": "fixed-plus-0530",
   "description": "a fixed offset +05:30",
   "input": {
    "zone": "+05:30",
    "local": "2026-11-18T15:45:42"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-18T10:15:42.000Z",
    "fold": "none"
   }
  },
  {
   "id": "fixed-minus-0800-compact",
   "description": "a fixed offset written -0800",
   "input": {
    "zone": "-0800",
    "local": "2026-01-01T00:00:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-01-01T08:00:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "fixed-plus-14",
   "description": "the largest offset +14:00 reaches into the previous UTC day",
   "input": {
    "zone": "+14:00",
    "local": "2026-01-01T00:00:00"
   },
   "expected": {
    "ok": true,
    "utc": "2025-12-31T10:00:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "ny-before-spring-forward",
   "description": "New York, one second before the jump: still EST (-05:00)",
   "input": {
    "zone": "America/New_York",
    "local": "2026-03-08T01:59:59"
   },
   "expected": {
    "ok": true,
    "utc": "2026-03-08T06:59:59.000Z",
    "fold": "none"
   }
  },
  {
   "id": "ny-gap",
   "description": "New York 02:30 on 2026-03-08 does not exist: read with the offset before the jump (-05:00)",
   "input": {
    "zone": "America/New_York",
    "local": "2026-03-08T02:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-03-08T07:30:00.000Z",
    "fold": "gap"
   }
  },
  {
   "id": "ny-after-spring-forward",
   "description": "New York 03:00 is EDT (-04:00), the first instant after the jump",
   "input": {
    "zone": "America/New_York",
    "local": "2026-03-08T03:00:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-03-08T07:00:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "ny-before-fall-back",
   "description": "New York 00:59:59 on 2026-11-01 is still EDT",
   "input": {
    "zone": "America/New_York",
    "local": "2026-11-01T00:59:59"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-01T04:59:59.000Z",
    "fold": "none"
   }
  },
  {
   "id": "ny-overlap",
   "description": "New York 01:30 on 2026-11-01 happens twice: the first (EDT, -04:00) is taken",
   "input": {
    "zone": "America/New_York",
    "local": "2026-11-01T01:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-01T05:30:00.000Z",
    "fold": "ambiguous"
   }
  },
  {
   "id": "ny-after-fall-back",
   "description": "New York 02:00 on 2026-11-01 is EST (-05:00)",
   "input": {
    "zone": "America/New_York",
    "local": "2026-11-01T02:00:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-11-01T07:00:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "berlin-gap",
   "description": "Berlin 02:30 on 2026-03-29 does not exist: read as CET (+01:00)",
   "input": {
    "zone": "Europe/Berlin",
    "local": "2026-03-29T02:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-03-29T01:30:00.000Z",
    "fold": "gap"
   }
  },
  {
   "id": "berlin-after-jump",
   "description": "Berlin 03:30 on 2026-03-29 is CEST (+02:00): the same instant as the gap time",
   "input": {
    "zone": "Europe/Berlin",
    "local": "2026-03-29T03:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-03-29T01:30:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "berlin-overlap",
   "description": "Berlin 02:30 on 2026-10-25 happens twice: the first (CEST, +02:00) is taken",
   "input": {
    "zone": "Europe/Berlin",
    "local": "2026-10-25T02:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-10-25T00:30:00.000Z",
    "fold": "ambiguous"
   }
  },
  {
   "id": "berlin-after-overlap",
   "description": "Berlin 03:30 on 2026-10-25 is CET (+01:00)",
   "input": {
    "zone": "Europe/Berlin",
    "local": "2026-10-25T03:30:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-10-25T02:30:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "lord-howe-gap",
   "description": "Lord Howe's jump is 30 minutes: 02:15 on 2026-10-04 does not exist, read as +10:30",
   "input": {
    "zone": "Australia/Lord_Howe",
    "local": "2026-10-04T02:15:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-10-03T15:45:00.000Z",
    "fold": "gap"
   }
  },
  {
   "id": "lord-howe-after-jump",
   "description": "Lord Howe 02:45 on 2026-10-04 is +11:00: the same instant as the gap time",
   "input": {
    "zone": "Australia/Lord_Howe",
    "local": "2026-10-04T02:45:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-10-03T15:45:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "lord-howe-overlap",
   "description": "Lord Howe 01:45 on 2026-04-05 happens twice: the first (+11:00) is taken",
   "input": {
    "zone": "Australia/Lord_Howe",
    "local": "2026-04-05T01:45:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-04-04T14:45:00.000Z",
    "fold": "ambiguous"
   }
  },
  {
   "id": "lord-howe-after-overlap",
   "description": "Lord Howe 02:15 on 2026-04-05 is +10:30",
   "input": {
    "zone": "Australia/Lord_Howe",
    "local": "2026-04-05T02:15:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-04-04T15:45:00.000Z",
    "fold": "none"
   }
  },
  {
   "id": "utc-label-offset-zone",
   "description": "Etc/GMT+5 is UTC-05:00 (the sign is inverted in the name)",
   "input": {
    "zone": "Etc/GMT+5",
    "local": "2026-06-01T12:00:00"
   },
   "expected": {
    "ok": true,
    "utc": "2026-06-01T17:00:00.000Z",
    "fold": "none"
   }
  },
  {
